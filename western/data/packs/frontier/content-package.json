  "storyScripts": {
    "frontier": {
      "version": 3,
      "segments": [
        {
          "name": "frontier_arrival",
          "steps": [
            {
              "kind": "dialogue",
              "speaker": "营地执事",
              "text": "你来得正好。渡口的药和粮已经见底，送货的两辆车却迟了整整一天。"
            },
            {
              "kind": "dialogue",
              "speaker": "主角",
              "text": "我只带着一把旧剑。你需要的是骑士，还是肯干活的人？"
            },
            {
              "kind": "dialogue",
              "speaker": "营地执事",
              "text": "肯干活、懂得活着回来的人。先拿这些钱置办护衣，带上敷药。东边的斥候玛拉也许愿意同去。"
            },
            {
              "kind": "command",
              "call": "item('frontier_arming_sword', 1)"
            },
            {
              "kind": "command",
              "call": "item('frontier_breathing_notes', 1)"
            },
            {
              "kind": "command",
              "call": "item('frontier_field_dressing', 2)"
            },
            {
              "kind": "command",
              "call": "change_silver(80)"
            },
            {
              "kind": "dialogue",
              "speaker": "营地执事",
              "text": "稳息笔记是我从前的行军记录。装备好剑，把笔记放进修炼栏；学会的本领，比好运气更靠得住。"
            },
            {
              "kind": "command",
              "call": "suggest('此地罕有真正的魔法。装备、走位和伙伴配合将决定你能否完成第一份委托。')"
            }
          ]
        },
        {
          "name": "frontier_contract_briefing",
          "steps": [
            {
              "kind": "dialogue",
              "speaker": "营地执事",
              "text": "沿东行旧道查查车辙。若找到补给，带回封蜡账册；别一个人逞英雄。"
            }
          ]
        },
        {
          "name": "frontier_recruit_mara",
          "steps": [
            {
              "kind": "dialogue",
              "speaker": "玛拉",
              "text": "你也是为失踪的补给来的？我听见废塔那边有车轮声。"
            },
            {
              "kind": "choice",
              "prompt": {
                "speaker": "主角",
                "text": "要邀请这名斥候同行吗？"
              },
              "blocks": [
                {
                  "kind": "options",
                  "options": [
                    {
                      "text": "一起去，战利品公平分。",
                      "steps": [
                        {
                          "kind": "dialogue",
                          "speaker": "玛拉",
                          "text": "说定了。你守正面，我从侧面寻找机会。"
                        },
                        {
                          "kind": "command",
                          "call": "join('frontier_mara')"
                        }
                      ]
                    },
                    {
                      "text": "我先准备一下。",
                      "steps": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "frontier_mara_ready",
          "steps": [
            {
              "kind": "dialogue",
              "speaker": "玛拉",
              "text": "东行旧道有一处路障。记住，追着一个敌人跑的时候，也要看住同伴的退路。"
            }
          ]
        },
        {
          "name": "frontier_road_encounter",
          "steps": [
            {
              "kind": "dialogue",
              "speaker": "逃兵",
              "text": "留下吃的。我们已经三天没有领到口粮了。"
            },
            {
              "kind": "dialogue",
              "speaker": "主角",
              "text": "你拦住的是给难民送药的车。把路让开，我们才都有机会活下去。"
            },
            {
              "kind": "dialogue",
              "speaker": "逃兵",
              "text": "少说漂亮话！"
            },
            {
              "kind": "battle",
              "battleId": "frontier_road_skirmish",
              "outcomes": {
                "win": [
                  {
                    "kind": "command",
                    "call": "set_flag('frontier_road_won')"
                  },
                  {
                    "kind": "dialogue",
                    "speaker": "逃兵",
                    "text": "车没在我这里……是灰巾帮，他们把车拖进了废塔。"
                  }
                ],
                "lose": [
                  {
                    "kind": "dialogue",
                    "speaker": "主角",
                    "text": "先撤回营地，重新准备护衣与敷药。"
                  },
                  {
                    "kind": "command",
                    "call": "map('frontier_camp')"
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "frontier_road_after",
          "steps": [
            {
              "kind": "dialogue",
              "speaker": "主角",
              "text": "车辙还很新。叫上玛拉，去瞭望塔看看。"
            }
          ]
        },
        {
          "name": "frontier_ruins_encounter",
          "steps": [
            {
              "kind": "dialogue",
              "speaker": "玛拉",
              "text": "那是渡口商队的封蜡。一个人在门口，另一个守着账册。"
            },
            {
              "kind": "dialogue",
              "speaker": "灰巾头目",
              "text": "交不起过路钱，就别想让货过去。"
            },
            {
              "kind": "choice",
              "prompt": {
                "speaker": "主角",
                "text": "如何处理这批补给？"
              },
              "blocks": [
                {
                  "kind": "options",
                  "options": [
                    {
                      "text": "拿回补给，协同进攻。",
                      "steps": [
                        {
                          "kind": "battle",
                          "battleId": "frontier_ruins_skirmish",
                          "outcomes": {
                            "win": [
                              {
                                "kind": "command",
                                "call": "set_flag('frontier_ruins_won')"
                              },
                              {
                                "kind": "command",
                                "call": "item('frontier_sealed_ledger', 1)"
                              },
                              {
                                "kind": "dialogue",
                                "speaker": "玛拉",
                                "text": "账册找到了。回营把好消息交给执事，大家今晚终于能吃上饭。"
                              }
                            ],
                            "lose": [
                              {
                                "kind": "dialogue",
                                "speaker": "玛拉",
                                "text": "还撑得住！先撤，我们重新准备。"
                              },
                              {
                                "kind": "command",
                                "call": "map('frontier_camp')"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "text": "先退回旧道准备。",
                      "steps": [
                        {
                          "kind": "command",
                          "call": "map('frontier_wilds')"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "frontier_ruins_cleared",
          "steps": [
            {
              "kind": "dialogue",
              "speaker": "玛拉",
              "text": "补给已经交给车夫运回去。我们也该返回渡口了。"
            }
          ]
        },
        {
          "name": "frontier_contract_complete",
          "steps": [
            {
              "kind": "branch",
              "cases": [
                {
                  "when": "has_flag('frontier_contract_paid')",
                  "steps": [
                    {
                      "kind": "dialogue",
                      "speaker": "营地执事",
                      "text": "你的第一份委托完成得很好。休整一下，下一段路还很长。"
                    }
                  ]
                }
              ],
              "fallback": [
                {
                  "kind": "dialogue",
                  "speaker": "营地执事",
                  "text": "我认得这枚封蜡。你们保住了营地这一周的口粮。"
                },
                {
                  "kind": "dialogue",
                  "speaker": "主角",
                  "text": "塔里那些人知道商队的路线。有人向他们递了消息。"
                },
                {
                  "kind": "dialogue",
                  "speaker": "玛拉",
                  "text": "账册上还有一个黑鸦印记。我会去查查。"
                },
                {
                  "kind": "command",
                  "call": "change_silver(120)"
                },
                {
                  "kind": "command",
                  "call": "set_flag('frontier_contract_paid')"
                },
                {
                  "kind": "dialogue",
                  "speaker": "营地执事",
                  "text": "这是说好的报酬。今晚先歇一歇；等你们准备好了，再去找那个印记的主人。"
                },
                {
                  "kind": "command",
                  "call": "suggest('第一份委托完成。装备、修炼、队伍与货币会一起存入当前世界的存档。')"
                }
              ]
            }
          ]
        }
      ]
    }
  },
