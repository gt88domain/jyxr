    "独孤九剑破剑式": {
      "en": "Can apply Sword Lock to a target you hit for 4 turns, blocking Swordsmanship techniques and their advanced forms. Special abilities are unaffected by this seal. Targets can resist it. Check the live Energy, Rage, cooldown, and highlighted targets before using this technique.",
      "zh-CN": "命中后可施加持续4回合的剑术封锁，阻止剑术及其进阶招式；特殊能力不受此封锁影响。目标可抵抗此状态。使用前请确认战斗中的实际能量、怒气、冷却与高亮目标。"
    },
    "独孤九剑破刀式": {
      "en": "Can apply Heavy Weapon Lock to a target you hit for 4 turns, blocking Heavy Weapons techniques and their advanced forms. Special abilities are unaffected by this seal. Targets can resist it. Check the live Energy, Rage, cooldown, and highlighted targets before using this technique.",
      "zh-CN": "命中后可施加持续4回合的重武器封锁，阻止重武器战技及其进阶招式；特殊能力不受此封锁影响。目标可抵抗此状态。使用前请确认战斗中的实际能量、怒气、冷却与高亮目标。"
    },
    "独孤九剑破掌式": {
      "en": "Can apply Gauntlet Lock to a target you hit for 4 turns, blocking Gauntlets techniques and their advanced forms. Special abilities are unaffected by this seal. Targets can resist it. Check the live Energy, Rage, cooldown, and highlighted targets before using this technique.",
      "zh-CN": "命中后可施加持续4回合的拳套封锁，阻止拳套战技及其进阶招式；特殊能力不受此封锁影响。目标可抵抗此状态。使用前请确认战斗中的实际能量、怒气、冷却与高亮目标。"
    },
    "独孤九剑破兵式，破各种奇门技能": {
      "en": "Can apply Spell Lock to a target you hit for 4 turns, blocking Spells and their advanced forms. Special abilities are unaffected by this seal. Targets can resist it. Check the live Energy, Rage, cooldown, and highlighted targets before using this technique.",
      "zh-CN": "命中后可施加持续4回合的法术封锁，阻止法术及其进阶招式；特殊能力不受此封锁影响。目标可抵抗此状态。使用前请确认战斗中的实际能量、怒气、冷却与高亮目标。"
    },
    "苍松迎客": {
      "en": "An area technique from Crane-wing Swordplay. It uses a star-shaped area centered on the caster and has no built-in status effect. Check the live Energy, Rage, cooldown, and highlighted targets before using it.",
      "zh-CN": "鹤翼剑术的范围招式，以施术者为中心形成星形作用区域，不自带附加状态。使用前请确认战斗中的实际能量、怒气、冷却与高亮目标。"
    },
    "易筋经中记载的绝世武艺": {
      "en": "An area attack unlocked by Ironbody Mastery. On a successful hit, it can inflict Energy Drain III on the target for 3 turns and grant you Defense Up X for 1 turn. Targets can resist the drain. Check the live Energy, Rage, cooldown, and highlighted targets before using it.",
      "zh-CN": "铁躯专精解锁的范围攻击。命中后可使目标能量流失III持续3回合，并使施术者防御提升X持续1回合；目标可抵抗能量流失。使用前请确认战斗中的实际能量、怒气、冷却与高亮目标。"
    },
    "我是流氓我怕谁！": {
