  "segments": {
    "mainStory_紧急.洛阳": {
      "en": [
        "Somebody help! They're coming this way!",
        "Out of my way!",
        "You'll have to get past us first."
      ],
      "zh-CN": [
        "来人帮帮忙！他们朝这边来了！",
        "给我让开！",
        "那得先过我们这一关。"
      ]
    },
    "mainStory_紧急.洛阳胜": {
      "en": ["They've pulled back. I hope that buys this town some peace."],
      "zh-CN": ["他们退了。希望镇上能安稳一阵。"]
    },
    "mainStory_紧急.衡阳": {
      "en": [
        "Please! They're right behind me!",
        "You can't hide in the market.",
        "She doesn't need to. We're right here."
      ],
      "zh-CN": [
        "救救我！他们就在我身后！",
        "躲进集市也没用。",
        "她不用躲。我们就在这里。"
      ]
    },
    "mainStory_紧急.衡阳胜": {
      "en": ["The street's clear. Time to move on."],
      "zh-CN": ["街上没事了。该继续上路了。"]
    }
  }
