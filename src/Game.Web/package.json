{
  "name": "jyxr-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract": "python3 scripts/generate-contract.py",
    "content": "python3 scripts/build-frontier.py",
    "runtime": "node scripts/build-runtime.mjs",
    "prepare:game": "npm run content && npm run runtime",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run contract && npm run prepare:game && tsc --noEmit && vite build",
    "package": "npm run build && python3 scripts/package-web.py",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/frontier-smoke.mjs",
    "test:equipment": "node tests/equipment-smoke.mjs",
    "test:chapter": "node tests/chapter-smoke.mjs",
    "test:original": "node tests/original-world-smoke.mjs",
    "test:art": "node tests/legacy-art-smoke.mjs",
    "test:creation": "python3 tests/creation-source-parity.py && node tests/creation-smoke.mjs",
    "test:management": "node tests/management-smoke.mjs",
    "test:minigame": "node tests/minigame-smoke.mjs",
    "test:flow": "node tests/flow-smoke.mjs",
    "test:achievements": "node tests/achievement-smoke.mjs",
    "test:battle-items": "node tests/battle-item-smoke.mjs",
    "test:timeout": "node tests/timeout-smoke.mjs",
    "test:journal": "node tests/journal-smoke.mjs",
    "test:touch": "node tests/touch-smoke.mjs",
    "test:battle-return": "node tests/battle-return-smoke.mjs",
    "test:experience": "node tests/experience-smoke.mjs",
    "test:advanced-skills": "node tests/advanced-skills-smoke.mjs",
    "test:progress": "node tests/progress-smoke.mjs",
    "test:companion-source": "python3 tests/companion-source-audit.py",
    "test:companions": "node tests/companions-smoke.mjs",
    "test:survival": "node tests/survival-smoke.mjs",
    "audit:library": "python3 tests/original-library-audit.py",
    "test:library": "node tests/library-smoke.mjs",
    "test:starting-companions": "node tests/starting-companions-smoke.mjs",
    "audit:schools": "python3 tests/school-source-audit.py",
    "audit:attributes": "python3 tests/attribute-source-audit.py",
    "audit:controls": "python3 tests/control-source-audit.py",
    "audit:mastery": "python3 tests/mastery-source-audit.py",
    "audit:legends": "python3 tests/legend-source-audit.py",
    "test:stage80": "node tests/stage80-smoke.mjs",
    "test:stage90": "node tests/stage90-smoke.mjs",
    "test:modern-m2": "node tests/modern-m2-smoke.mjs",
    "test:modern-m3": "node --test tests/board-input.test.mjs && node tests/modern-m3-mobile-smoke.mjs",
    "test:interface": "node tests/interface-smoke.mjs",
    "test:navigation": "node tests/navigation-smoke.mjs",
    "audit:late-reference": "python3 tests/late-reference-source-audit.py",
    "test:late-reference": "node tests/late-reference-smoke.mjs",
    "audit:remaining": "python3 tests/remaining-source-audit.py",
    "assets:restore": "python3 scripts/frontier-assets.py",
    "test:frontier": "node tests/frontier-smoke.mjs"
  },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "playwright": "^1.58.0"
  }
}
