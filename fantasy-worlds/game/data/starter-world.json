          "value": "主角#你这么欠扁，请问我可以扁你吗？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#年轻人火气不要这么大，尊老爱幼是基本道德……来瓶凉茶降降火吧。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#……"
        },
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_南贤"
        }
      ]
    },
    "新手村_武师": {
      "id": "新手村_武师",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#哈喽，小兄弟，你是新来的吧？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#看你这装扮，就一定是教人打架的武师了。"
