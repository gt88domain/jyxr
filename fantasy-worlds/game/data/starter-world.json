    "新手村_武师1": {
      "id": "新手村_武师1",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_武师选择"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#从技能本身来说，分四大类：[[red:外功、内功、绝技、特殊技能。]]"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#外功就是战斗中可以直接使用的技能，也就是白色的技能。每个角色可以学习十种外功。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#内功关系到整个角色的各个属性增益，并且同时只能装备一种。一个角色可以学习五种内功。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#内功和外功学到一定程度，有些武学可以领悟绝技（红色技能），一般的绝技需要在战斗中积攒怒气才可以使用。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#特殊技能是指一些角色特有的功能（蓝色技能），一般都附带特殊效果，属于战斗中的战略性技能。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#从武学分类来说，武学又分四种：[[red:拳法、剑法、刀法、奇门。]]"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#所以，选择你想要学习的技能，搭配不同种类的技能才能在战斗中致胜。"
        }
      ]
    },
    "新手村_武师2": {
      "id": "新手村_武师2",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#每个人物都可以学习若干天赋，也有一些人物自带天赋。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#天赋给每个人物赋予了独特的属性，大部分是提供被动技能。可以在战斗中发挥特殊作用，如减少伤害、提高命中率等等。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#当然并不是每个天赋都是有益的，也有一些人物出场就自带坑爹天赋。甚至还有一些天赋会坑队友喔，这个需要你自己来把握。"
        },
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_武师选择"
        }
      ]
    },
    "新手村_武师3": {
      "id": "新手村_武师3",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#如果你加入一个门派的话，大部分顶级武学都是通过门派任务来获得的。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#当然，江湖上也有许多绝顶高手，机缘巧合的话，也许会教你个一招半式。如果有机会认识的话，赶紧和他们处好关系吧！"
        },
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_武师选择"
        }
      ]
    },
    "新手村_武师4": {
      "id": "新手村_武师4",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_武师选择"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#外功分三种，[[red:阴性、阳性以及阴阳调和。]]"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#例如丐帮洪老帮主的降龙十八掌，就是典型的阳性武功；而西毒欧阳前辈的灵蛇拳，就是典型的阴性武功……"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#阴阳调和的武功顾名思义，就是阴阳均适配，这种武学一般是高级武学，是否能学到就看你的机缘了。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#同理，所有的内功都带阴阳加成属性，你当前装备的内功将直接影响所选外功武学的威力。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#阳性武功加成取决于当前内功的阳适性，阴性武功加成取决于当前内功的阴适性，调和型武功加成取决于当前内功阴阳适性中较大的那个。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#简而言之，就是你如果要使用阳性的外功，就带阳属性的内功；阴性亦然。如果是调和型外功，就无所谓了。"
        }
      ]
    },
    "新手村_武师5": {
      "id": "新手村_武师5",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_武师选择"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#在江湖中闯荡，你将会遇到很多难缠的对手和艰难的战斗。那么如何在这种战斗中取胜呢？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#决定一场战斗的因素很多，主要包含以下几个方面："
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#1、走位——你将需要了解敌方的技能覆盖范围，敌方的走位意图，来进行选择，避免被敌人包围或者一次性群攻到你的队友。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#2、技能选择——合适的时候，释放合适的技能。请仔细思考，如本回合到底是应该发动进攻呢，还是应该退避防守。是应该给队友增强型技能呢，还是应该给敌方削弱型技能。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#3、上场队员——仔细分析一场战斗中敌方的弱点，针对性的培养队友，用人物属性、天赋克制的方式，能给战斗带来很大胜算加成。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#4、运气——由于奥义、攻击力等各方面因素的随机性都很强，在实力满足的情况下，你可能还需要一些运气！"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#最后，补充说一下，可能很多自动无法打过的战斗，由您亲手操作可以打过！所以艰难的战斗，不妨想象成一盘棋，当一个棋手去赢得胜利吧！"
        }
      ]
    },
    "新手村_武师6": {
      "id": "新手村_武师6",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_武师选择"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#俗话说，师傅带进门，修行靠个人。即使遇到再好的老师，你也很难从他那儿修行到一门武艺的顶峰。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#如果你想要突破武学上限，目前有几种方法："
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#1、在一些战斗中，会掉落武学残章，将会自动解锁该项武学的专精。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "武师#2、完成一些江湖奇遇，可能也会解锁武学的专精喔！但这些往往只能解锁一次，也就是说重复完成这项任务是没法反复获得奖励的。"
        }
      ]
    },
