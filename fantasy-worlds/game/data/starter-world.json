          "value": "音乐.室内_清新"
        },
        {
          "tag": "action",
          "type": "BACKGROUND",
          "value": "地图.农舍内"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#咦，这是哪里？"
        },
        {
