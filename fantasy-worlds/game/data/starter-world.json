  "stories": {
    "新手村_出生": {
      "id": "新手村_出生",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "result",
          "type": "map",
          "ret": "0",
          "value": "南贤屋内"
        },
        {
          "tag": "action",
