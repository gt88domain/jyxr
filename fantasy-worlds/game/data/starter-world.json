    "新手村_南贤开场": {
      "id": "新手村_南贤开场",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#年轻人，你醒了。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#这里是哪里？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#这里是金庸[[red:十四天书]]的世界。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#飞雪连天射白鹿，笑书神侠倚碧鸳？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#正是！"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#我穿越到这里来冒险了？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#正是！而且，你还不是第一次来！"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#我来过这里？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#正是！当然，那是90年代的事情了，请参见当时DOS版的金庸群侠传。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#你可以不要每次都说“正是”么？还打个感叹号吵得我耳朵都要聋了。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#……"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#那我这次来这里是要干什么？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#我也不知道。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#……"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#我只能告诉你，我感觉到有[[red:邪恶的气息]]在逼近，这个世界正在呼唤英雄。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#可是我什么武功都不会！"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#出去打打怪，练练级，很快的……"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#……我一个人闯江湖搞不定啊！妈妈说江湖坏人太多了。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#你可以[[yellow:招募小伙伴]]，这个江湖中有很多人愿意和你一起闯荡。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#但是因为一些未知的原因，曾经在DOS版和你一起闯荡的小伙伴都不认识你了，你得一切从头来过。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#我忽然很想知道这游戏编剧的工资是谁发的。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#……"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#好了，时间不早了，来，我带你到外头看看吧！"
        },
        {
          "tag": "action",
          "type": "NICK",
          "value": "初出茅庐"
        },
        {
          "tag": "action",
          "type": "LOG",
          "value": "再次来到金庸十四天书的世界。"
        },
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_小村介绍"
        }
      ]
    },
    "新手村_小村介绍": {
      "id": "新手村_小村介绍",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "action",
          "type": "BACKGROUND",
          "value": "地图.小村"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#不是这么老土吧？这就是这个游戏的新手村？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#我只能说，外头的世界很凶险……你还是在这里先学会一些基本的技能，再出去闯荡江湖吧。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#那我现在应该做些什么？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#村里有许多去处，你可以跟大伙学学基本的技能。我这里有一本记载了[[yellow:基本内功]]的心法，你拿去好好修炼吧。"
        },
        {
          "tag": "action",
          "type": "ITEM",
          "value": "内功入门#1"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#我靠，这是什么？内功入门？！至少拿点像样的东西嘛。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#老朽这儿也只有这点货了……你就将就着学着吧。"
        },
        {
          "tag": "action",
          "type": "SUGGEST",
          "value": "点击人物状态栏，点击修炼，可以装备内功入门。"
        },
        {
          "tag": "action",
          "type": "SUGGEST",
          "value": "装备上的武学经书，在战斗结束后能将获得的经验快速分配到该项武学上，可以迅速提升武学等级。"
        },
        {
          "tag": "result",
          "type": "map",
          "ret": "0",
          "value": "小村"
        }
      ]
    },
