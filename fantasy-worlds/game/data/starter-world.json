        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#当然，惩恶扬善是我辈本分。你的道德评价将直接和你在这个世界中的一举一动关联。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#究竟是要做一个大侠，还是一个坏蛋，完全取决于你自己！所以请慎重选择在这个江湖中的每一步吧！"
        }
      ]
    },
    "新手村_南贤_募集队友": {
      "id": "新手村_南贤_募集队友",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#大多数队友都是需要你完成固定剧情才能加入你。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#当然，剧情走向和你的每一步选择相关！"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#还有，每当你打通一个周目的时候，下个周目的时候可能会送给你神秘队友噢~"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#另外，还有松鼠旅馆，也是可以招募到强大的江湖侠士。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#总之，多到处逛逛，总是能让一些得力助手加入你的队伍的！"
        },
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_南贤"
        }
      ]
    },
    "新手村_南贤_DOS版": {
      "id": "新手村_南贤_DOS版",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#十多年前，你来到了这个世界。以江湖最常见的野球拳，打败了当世所有绝顶高手。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#当江湖奉你为武林盟主的时候，你却独自离开了这个世界。据说是回到了原本属于你自己的那个世界去了……"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#但你的故事，一直是江湖的一个丰碑、一个传说，或者说，你已经成为了江湖的一个信仰。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#如今，你又是新的你，这个世界却不曾记得你来过，你是否还能谱写神话——我们拭目以待！"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#哎，听你说得鸭梨好大，但貌似很有激情的样子……"
        },
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_南贤"
        }
      ]
    },
    "新手村_南贤_目标": {
      "id": "新手村_南贤_目标",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "result",
          "type": "story",
          "ret": "0",
          "value": "新手村_南贤"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#那么我到底来这个世界是为了什么？"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "南贤#刚才我已经说了，这个世界中，邪恶气息降临……送你回来，冥冥中也印证了你一定会要再续写一个武林传奇。"
        },
        {
          "tag": "action",
          "type": "DIALOG",
          "value": "主角#问你等于没问……"
        }
      ]
    },
    "新手村_南贤_打一架": {
      "id": "新手村_南贤_打一架",
      "source": "jyx-legacy-data/data-origin/storys.xml",
      "instructions": [
        {
          "tag": "action",
