Id":"大地图"},{"id":1501,"kind":"operation","message":"战场走位：x 7，y 1","notice":false,"time":"2026-10-24T22:48:22.4450328\u002B00:00","mapId":"大地图"},{"id":1502,"kind":"battle","message":"Wren施展「打鸡血」。","notice":false,"time":"2026-10-24T22:48:22.4768041\u002B00:00","mapId":"大地图"},{"id":1503,"kind":"operation","message":"战场走位：x 6，y 1","notice":false,"time":"2026-10-24T22:48:22.5213988\u002B00:00","mapId":"大地图"},{"id":1504,"kind":"battle","message":"Wren休息调息。","notice":false,"time":"2026-10-24T22:48:22.5462360\u002B00:00","mapId":"大地图"},{"id":1505,"kind":"battle","message":"哈萨克勇士休息调息。","notice":false,"time":"2026-10-24T22:48:22.5503208\u002B00:00","mapId":"大地图"},{"id":1506,"kind":"battle","message":"Wren休息调息。","notice":false,"time":"2026-10-24T22:48:22.5884092\u002B00:00","mapId":"大地图"},{"id":1507,"kind":"battle","message":"哈萨克勇士休息调息。","notice":false,"time":"2026-10-24T22:48:22.5944339\u002B00:00","mapId":"大地图"},{"id":1508,"kind":"battle","message":"哈萨克勇士受到 630 点伤害。","notice":false,"time":"2026-10-24T22:48:22.6398475\u002B00:00","mapId":"大地图"},{"id":1509,"kind":"battle","message":"Wren施展「野球拳.市井流氓」。","notice":false,"time":"2026-10-24T22:48:22.6398512\u002B00:00","mapId":"大地图"},{"id":1510,"kind":"growth","message":"Wren从10级升至11级。","notice":true,"time":"2026-10-24T22:48:22.6489271\u002B00:00","mapId":"大地图"},{"id":1511,"kind":"item","message":"获得「银手镯」×1","notice":true,"time":"2026-10-24T22:48:22.6507959\u002B00:00","mapId":"大地图"},{"id":1512,"kind":"battle","message":"战斗胜利，已按原有规则结算经验和掉落。","notice":false,"time":"2026-10-24T22:48:22.6508297\u002B00:00","mapId":"大地图"},{"id":1513,"kind":"operation","message":"施展招式：武功 野球拳.市井流氓，x 6，y 0","notice":false,"time":"2026-10-24T22:48:22.6508927\u002B00:00","mapId":"大地图"},{"id":1514,"kind":"dialogue","message":"李文秀：I can\u0027t beat you. What do you want?","notice":false,"time":"2026-10-24T22:48:22.6783383\u002B00:00","mapId":"大地图"},{"id":1515,"kind":"operation","message":"离开战斗","notice":false,"time":"2026-10-24T22:48:22.6783927\u002B00:00","mapId":"大地图"},{"id":1516,"kind":"dialogue","message":"主角：Answers. What is everyone risking their lives for?","notice":false,"time":"2026-10-24T22:48:22.7063952\u002B00:00","mapId":"大地图"},{"id":1517,"kind":"dialogue","message":"瓦耳拉齐：Shelves. Old instruments. Books. The conquerors took the gold long ago and left their idea of civilization behind.","notice":false,"time":"2026-10-24T22:48:22.7332348\u002B00:00","mapId":"大地图"},{"id":1518,"kind":"dialogue","message":"李文秀：My parents died for an empty treasury?","notice":false,"time":"2026-10-24T22:48:22.7583460\u002B00:00","mapId":"大地图"},{"id":1519,"kind":"dialogue","message":"瓦耳拉齐：For a rumor. A rumor is much harder to bury than gold.","notice":false,"time":"2026-10-24T22:48:22.7813518\u002B00:00","mapId":"大地图"},{"id":1520,"kind":"dialogue","message":"李文秀：Come home with me, please.","notice":false,"time":"2026-10-24T22:48:22.8162786\u002B00:00","mapId":"大地图"},{"id":1521,"kind":"dialogue","message":"瓦耳拉齐：Not yet. There are things I still have to settle.","notice":false,"time":"2026-10-24T22:48:22.8456919\u002B00:00","mapId":"大地图"},{"id":1522,"kind":"dialogue","message":"李文秀：Then I\u0027ll go back alone. Take care, traveler.","notice":false,"time":"2026-10-24T22:48:22.8687277\u002B00:00","mapId":"大地图"},{"id":1523,"kind":"dialogue","message":"主角：A book of old poems. Not gold, but it deserves a reader. I\u0027ll take it.","notice":false,"time":"2026-10-24T22:48:22.8929343\u002B00:00","mapId":"大地图"},{"id":1524,"kind":"item","message":"获得「河岳英灵集」×1","notice":true,"time":"2026-10-24T22:48:22.9183534\u002B00:00","mapId":"大地图"},{"id":1525,"kind":"operation","message":"与地点交互：地点 高昌迷宫","notice":false,"time":"2026-10-24T22:48:22.9518937\u002B00:00","mapId":"高昌迷宫"},{"id":1526,"kind":"operation","message":"与地点交互：地点 返回","notice":false,"time":"2026-10-24T22:48:22.9753896\u002B00:00","mapId":"大地图"},{"id":1527,"kind":"operation","message":"与地点交互：地点 高昌迷宫","notice":false,"time":"2026-10-24T22:48:23.0011496\u002B00:00","mapId":"高昌迷宫"},{"id":1528,"kind":"dialogue","message":"主角：Still searching, Sir Knight? The warrens hold old books, not gold.","notice":false,"time":"2026-10-24T22:48:23.0314006\u002B00:00","mapId":"高昌迷宫"},{"id":1529,"kind":"operation","message":"与地点交互：地点 陈达海","notice":false,"time":"2026-10-24T22:48:23.0314815\u002B00:00","mapId":"高昌迷宫"},{"id":1530,"kind":"dialogue","message":"陈达海：Then I have charged across half the desert for... a library?","notice":false,"time":"2026-10-24T22:48:23.0615795\u002B00:00","mapId":"高昌迷宫"},{"id":1531,"kind":"dialogue","message":"主角：Not your worst charge. But the people in camp deserve an apology.","notice":false,"time":"2026-10-24T22:48:23.0868467\u002B00:00","mapId":"高昌迷宫"},{"id":1532,"kind":"dialogue","message":"陈达海：A knight should put things right. If someone could point me in the right direction.","notice":false,"time":"2026-10-24T22:48:23.1129027\u002B00:00","mapId":"高昌迷宫"},{"id":1533,"kind":"party","message":"陈达海加入队伍（参战）。","notice":true,"time":"2026-10-24T22:48:23.1668927\u002B00:00","mapId":"高昌迷宫"},{"id":1534,"kind":"operation","message":"选择剧情分支：选项 0","notice":false,"time":"2026-10-24T22:48:23.1690153\u002B00:00","mapId":"高昌迷宫"},{"id":1535,"kind":"operation","message":"分配属性：属性 bili，points 6","notice":false,"time":"2026-10-24T22:48:23.2302388\u002B00:00","mapId":"高昌迷宫"},{"id":1536,"kind":"operation","message":"分配属性：属性 bili，points 4","notice":false,"time":"2026-10-24T22:48:23.2758919\u002B00:00","mapId":"高昌迷宫"},{"id":1537,"kind":"story","message":"【陈达海】装备【金头箍】","notice":false,"time":"2026-10-24T22:48:23.3290038\u002B00:00","mapId":"高昌迷宫"},{"id":1538,"kind":"operation","message":"穿戴装备：物品编号 8","notice":false,"time":"2026-10-24T22:48:23.3291296\u002B00:00","mapId":"高昌迷宫"},{"id":1539,"kind":"operation","message":"与地点交互：地点 返回","notice":false,"time":"2026-10-24T22:48:23.3742761\u002B00:00","mapId":"大地图"}]}}